# ============================================================
# AgentHive SaaS — Production Environment Configuration
# ============================================================

# --- App ---
APP_NAME=AgentHive
APP_VERSION=1.0.0
DEBUG=false
HOST=0.0.0.0
PORT=8000

# --- Database ---
# SQLite (default): DATABASE_URL=sqlite:///./data.db
# PostgreSQL: DATABASE_URL=postgresql+asyncpg://user:pass@localhost/dbname
DATABASE_URL=sqlite:///./data.db

# --- Security ---
JWT_SECRET=change-this-to-a-strong-random-secret-min-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- AI Model API Keys (get from respective providers) ---
# DeepSeek: https://platform.deepseek.com/
DEEPSEEK_API_KEY=sk-your-deepseek-key

# Groq: https://console.groq.com/
GROQ_API_KEY=gsk-your-groq-key

# OpenAI: https://platform.openai.com/
OPENAI_API_KEY=sk-your-openai-key

# --- Payments (Razorpay) ---
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret

# --- Email (SendGrid) ---
SENDGRID_API_KEY=SG.your_sendgrid_key
FROM_EMAIL=noreply@yourdomain.com

# --- CORS ---
ALLOWED_HOSTS=*
